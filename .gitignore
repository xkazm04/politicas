# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data layer (embedded Postgres + cached open-data dumps + analysis working set)
/.pglite
/.pglite-*
/.data
/.data-analysis
/.kg-analysis
/.hybrid-bench

# Personal cost data - the Personas passport reads it locally; never in VCS (rule committed on master)
app-cost.json
/scripts/**/node_modules/
/.db-bench
